# Ejemplo de configuracion de EventFlow para desarrollo local (sin secretos reales).
# Copiar como .env.dev (o .env.qa) para particularizar; el entorno del sistema
# siempre tiene precedencia sobre el archivo, y los defaults sobre ambos.

ENVIRONMENT=dev
PORT=8080

# PostgreSQL local del laboratorio. Desde el host, Compose publica PostgreSQL
# en 5434; dentro de los contenedores el servicio escucha en 5432.
DB_HOST=localhost
DB_PORT=5434
DB_USER=eventflow
DB_PASSWORD=eventflow
DB_NAME=eventflow
DB_SSL_MODE=disable

# Observabilidad; LOG_LEVEL y LOG_FORMAT toman efecto real desde MT-04
LOG_LEVEL=info
LOG_FORMAT=json

# Tiempos en el formato de duracion de la base, por ejemplo 15s
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

# Solo el worker usa RabbitMQ; la API no requiere esta variable. Al ejecutar
# dentro de Compose se sustituye por el hostname interno rabbitmq.
AMQP_URL=amqp://guest:guest@localhost:5672/
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=20
PUBLISH_CONFIRM_TIMEOUT=5s
CONSUMER_PREFETCH=1
